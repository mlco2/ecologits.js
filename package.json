{
    "name": "ecologits.js",
    "version": "3.0.0",
    "description": "TypeScript port of the ecologits methodology (mlco2/ecologits)",
    "private": true,
    "license": "MPL-2.0",
    "packageManager": "npm@11.3.0",
    "homepage": "https://ecologits.ai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mlco2/ecologits.js.git"
    },
    "engines": {
        "node": ">=20"
    },
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "typecheck": "turbo run typecheck",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "clean": "turbo run clean",
        "sync-data": "node scripts/sync-data.mjs",
        "check-data": "node scripts/sync-data.mjs --check",
        "check-spec": "node scripts/check-spec.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "devDependencies": {
        "@eslint/js": "^9.17.0",
        "@types/node": "^22.10.2",
        "@vitest/coverage-v8": "^2.1.8",
        "ajv": "^8.20.0",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^9.1.0",
        "prettier": "^3.4.2",
        "tsup": "^8.3.5",
        "turbo": "^2.3.3",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.1",
        "vitest": "^2.1.8"
    }
}
