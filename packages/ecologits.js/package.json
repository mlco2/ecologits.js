{
    "name": "@ecologits/ecologits.js",
    "version": "3.0.0",
    "description": "Core library for the Ecologits project, port of the ecologits methodology to TypeScript",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "source": "src/index.ts",
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test",
        "test": "vitest run",
        "watch": "tsup --watch",
        "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
        "prepublishOnly": "npm run build",
        "prepack": "node -e \"require('node:fs').copyFileSync('../../LICENSE', 'LICENSE')\""
    },
    "files": [
        "dist"
    ],
    "homepage": "https://ecologits.ai",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mlco2/ecologits.js.git",
        "directory": "packages/ecologits.js"
    },
    "license": "MPL-2.0",
    "engines": {
        "node": ">=20"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org/",
        "tag": "latest"
    }
}
