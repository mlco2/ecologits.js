{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://ecologits.ai/spec/schema/manifest.schema.json",
    "title": "spec manifest",
    "description": "Describes the spec version, the reference implementation the vectors came from, and the contract vectors.",
    "type": "object",
    "required": ["specVersion", "reference", "vectors"],
    "properties": {
        "specVersion": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "reference": {
            "type": "object",
            "required": ["implementation", "version", "commit", "pythonVersion"],
            "properties": {
                "implementation": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "commit": {
                    "type": ["string", "null"]
                },
                "pythonVersion": {
                    "type": "string",
                    "minLength": 1
                }
            },
            "additionalProperties": false
        },
        "vectors": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "required": ["kind", "path", "contract"],
                "properties": {
                    "kind": {
                        "type": "string",
                        "minLength": 1
                    },
                    "path": {
                        "type": "string",
                        "pattern": "^vectors/"
                    },
                    "contract": {
                        "enum": ["output"]
                    }
                },
                "additionalProperties": false
            }
        }
    },
    "additionalProperties": false
}
